# Copy this file to the runtime path used by your app and monitor, then edit it.
#
# Electron runtime on Windows:
#   C:\noti_app_electron\noti_ntfy.env
#
# Codex monitor in WSL:
#   ~/.config/noti_ntfy.env
# or set NOTI_NTFY_ENV_FILE=/path/to/noti_ntfy.env

NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=agent_switchboard_demo_topic_change_me

# Optional auth. Use either token, basic auth, or a full Authorization header.
NTFY_TOKEN=
NTFY_USERNAME=
NTFY_PASSWORD=
NTFY_AUTH_HEADER=

# Optional label added by codex_session_monitor/codex_sessions.py.
NOTI_HOST_ID=
